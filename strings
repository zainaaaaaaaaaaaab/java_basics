import java.util.Scanner;

public class strings{

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
       
        // concatenation
        String firstName = "John";
        String lastName = "Doe";
        String name = firstName + " " + lastName;
        System.out.println("Full name: " + name);

        // for length
        System.out.println("Length of full name: " + name.length());

        //for single letters charAt is used
        for(int i=0;i<name.length();i++){
            System.out.println("Character at index " + i + ": " + name.charAt(i));
        }

        //compareTo method basically (==,<,>) alternative which is more accurate 
        String str1 = "apple";
        String str2 = "banana";

        if(str1.compareTo(str2) == 0){
            System.out.println("Both strings are equal");
        } else {
            System.out.println("Strings are not equal");
        }

        //substring
        String str3 = "Hello, World!";
        String word = str3.substring(7, 12); // in index k bichka print hojaega
        System.out.println("Substring: " + word); // output = World


        //------STRING BUILDER
        StringBuilder sb = new StringBuilder("Hello");
        System.out.println(sb);

        // set char at index 0
        sb.setCharAt(0,'M');
        System.out.println(sb);

        //insert
        sb.insert(0,'F');
        System.out.println(sb);

        // delete 
        sb.delete(2,3);
        System.out.println(sb);

        // append (addition)
        sb.append(" W");
        sb.append("oo");
        System.out.println(sb);
    }
}
