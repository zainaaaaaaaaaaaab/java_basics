import java.util.Scanner;

public class basics {

    public static void main(String[] args) {
        System.out.println("Say hi!");

        // this is how you take input in java
        Scanner sc = new Scanner(System.in);
        String write = sc.nextLine();
        System.out.println("You wrote: " + write);


        // this is how you call a function in java
        int sum = calculateSum(5, 10);
        System.out.println("The sum is: " + sum);

        
        // this is how you declare an array in java 
        int size = sc.nextInt();
        int arr[] = new int[size];

        for(int i=0; i<size; i++) {
            arr[i] = sc.nextInt();
        }
        
        for(int i=0; i<size; i++) {
            System.out.println(arr[i]);
        }

    }
    // functon definition outside main
    public static int calculateSum(int a, int b) {
        return a + b;
    }
}
